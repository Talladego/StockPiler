<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
    <Windows>
        <!-- Default 50% of 92/64 layout; /stp button sets scale at runtime. -->
        <Button name="StockPilerCraftButton" inherits="EA_Button_Default" handleinput="true" movable="false" sticky="false" savesettings="true" layer="default" gameactionbutton="left" drawchildrenfirst="true">
            <Size>
                <AbsPoint x="46" y="46"/>
            </Size>
            <Anchors>
                <Anchor point="center" relativePoint="center" relativeTo="Root">
                    <AbsPoint x="200" y="120"/>
                </Anchor>
            </Anchors>
            <EventHandlers>
                <EventHandler event="OnLButtonDown" function="StockPiler.CraftButton.OnLButtonDown"/>
                <EventHandler event="OnLButtonUp" function="StockPiler.CraftButton.OnLButtonUp"/>
                <EventHandler event="OnRButtonUp" function="StockPiler.CraftButton.OnRButtonUp"/>
                <EventHandler event="OnMouseOver" function="StockPiler.CraftButton.OnMouseOver"/>
                <EventHandler event="OnMouseOverEnd" function="StockPiler.CraftButton.OnMouseOverEnd"/>
            </EventHandlers>
            <Windows>
                <CircleImage name="$parentIcon" handleinput="false" layer="background" textureScale="0.5" numsegments="32">
                    <Size>
                        <AbsPoint x="32" y="32"/>
                    </Size>
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parent">
                            <AbsPoint x="0" y="0"/>
                        </Anchor>
                    </Anchors>
                </CircleImage>
                <DynamicImage name="$parentFrame" handleinput="false" texture="EA_TempTargets_d3" slice="frame" textureScale="0.359" layer="overlay">
                    <Size>
                        <AbsPoint x="46" y="46"/>
                    </Size>
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parent">
                            <AbsPoint x="0" y="0"/>
                        </Anchor>
                    </Anchors>
                </DynamicImage>
            </Windows>
        </Button>
    </Windows>
</Interface>
