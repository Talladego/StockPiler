                        <Anchor point="bottomright" relativePoint="bottomright">
                            <AbsPoint x="-6" y="-8" />
                        </Anchor>
                    </Anchors>
                    <ListData table="StockPilerTabAutoGrow.listData" populationfunction="StockPilerTabAutoGrow.UpdateRows">
